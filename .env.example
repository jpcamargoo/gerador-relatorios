# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── AI Provider (github | openai | anthropic | azure | gemini) ────
AI_PROVIDER=gemini

# Google Gemini (recomendado)
# Gere sua chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# GitHub Models (GRÁTIS)
# GITHUB_TOKEN=ghp_your-github-token-here
# GITHUB_MODEL=gpt-4o-mini

# OpenAI (pago)
# OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (pago)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Azure OpenAI (pago)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# ─── JWT ─────────────────────────────────────────────
# Troque os secrets em produção!
JWT_SECRET=troque-em-producao
JWT_REFRESH_SECRET=troque-refresh-em-producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────
# Em produção, defina a URL do frontend (ex: https://meusite.com)
# Use * para permitir qualquer origem (apenas desenvolvimento)
CORS_ORIGIN=*

# ─── Storage ─────────────────────────────────────────
STORAGE_DIR=./storage
PDF_OUTPUT_DIR=./output
